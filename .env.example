# Optional configuration; every value has a safe local default. No secrets are needed.
# Worker threads used by the CPU backends (default: all hardware threads)
TSDX_NUM_THREADS=
# Seed for the error-lab matrix generators (default 0)
TSDX_SEED=0
# Output directory for report / benchmark artifacts (default docs/report)
TSDX_OUT_DIR=docs/report
